datasource db {
  provider = "sqlite"
}

generator client {
  provider          = "prisma-client"
  output            = "../src/backend/generated/prisma"
  moduleFormat      = "esm"
  importFileExtension = "ts"   
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("CUSTOMER")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  carts        Cart[]
  orders       Order[]
  addresses    Address[]

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String      @default("")
  price       Float
  stock       Int         @default(0)
  image       String      @default("sem-foto.jpg")
  categoryId  Int         @map("category_id")
  category    Category    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("products")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cart_items")
}

model Order {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  user               User               @relation(fields: [userId], references: [id])
  totalPrice         Float              @map("total_price")
  status             String             @default("CONFIRMED") // CONFIRMED, PREPARING, SHIPPED, DELIVERED
  shipToName         String?            @map("ship_to_name")
  shipToCep          String?            @map("ship_to_cep")
  shipToStreet       String?            @map("ship_to_street")
  shipToNumber       String?            @map("ship_to_number")
  shipToComplement   String?            @map("ship_to_complement")
  shipToNeighborhood String?            @map("ship_to_neighborhood")
  shipToCity         String?            @map("ship_to_city")
  shipToState        String?            @map("ship_to_state")
  createdAt          DateTime           @default(now()) @map("created_at")
  items              OrderItem[]
  statusEvents       OrderStatusEvent[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  priceAtPurchase Float @map("price_at_purchase") // Evita falha de seguranÃ§a se o preÃ§o do produto mudar amanhÃ£

  @@map("order_items")
}

model OrderStatusEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_status_events")
}

model Address {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?  @default("")
  recipientName String   @map("recipient_name")
  cep           String
  street        String
  number        String
  complement    String?  @default("")
  neighborhood  String
  city          String
  state         String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}