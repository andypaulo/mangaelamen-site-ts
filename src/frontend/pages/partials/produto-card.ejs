<%
// Partial: produto-card
// Espera receber `item` com: id, nome, descricao, categoria, preco, estoque, imagem
const esgotado = item.estoque <= 0;
const imagemSrc = item.imagem
  ? (item.imagem.startsWith('http') ? item.imagem : '/images/' + item.imagem)
  : '/images/sem-foto.jpg';
const precoFormatado = Number(item.preco).toFixed(2).replace('.', ',');
%>
<div class="relative bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-300 flex flex-col <%= esgotado ? 'opacity-75' : '' %>">

  <% if (esgotado) { %>
    <span class="absolute top-2.5 left-2.5 z-10 bg-red-600 text-white text-xs font-semibold px-2.5 py-1 rounded-full">Esgotado</span>
  <% } %>

  <div class="relative group">
    <img src="<%= imagemSrc %>" alt="<%= item.nome %>"
         class="w-full aspect-[2/3] object-contain bg-white p-2 transition-transform duration-300 group-hover:scale-105 <%= esgotado ? 'grayscale' : '' %>" />

    <button type="button" data-produto="<%= encodeURIComponent(JSON.stringify(item)) %>"
            class="btn-quick-view absolute top-2.5 right-2.5 bg-white/90 hover:bg-white text-[#111] text-xs font-semibold px-3 py-1.5 rounded-full shadow opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      Visualização rápida
    </button>
  </div>

  <div class="p-4 flex flex-col flex-1">
    <a href="/produtos/<%= item.id %>" class="no-underline text-inherit flex-1">
      <h5 class="font-semibold text-[#111] text-base mb-1 line-clamp-2"><%= item.nome %></h5>
      <p class="text-sm text-[#777] mb-2 line-clamp-2"><%= item.descricao %></p>
      <span class="inline-block bg-[#e9e9e9] text-[#444] text-xs font-medium px-2.5 py-1 rounded-full mb-2"><%= item.categoria %></span>
      <h4 class="text-brandpink font-bold text-xl mb-3">R$ <%= precoFormatado %></h4>
    </a>

    <div class="mt-auto flex flex-col gap-2">
      <% if (esgotado) { %>
        <button class="w-full bg-[#ccc] text-white font-semibold py-2 rounded-lg cursor-not-allowed" disabled>Indisponível</button>
      <% } else { %>
        <button onclick="comprarAgora(<%= item.id %>)" class="w-full bg-[#111] hover:bg-[#000] text-white font-semibold py-2 rounded-lg transition-colors">Comprar Agora</button>
        <button onclick="adicionarCarrinho(<%= item.id %>)" class="w-full bg-brandpink hover:bg-[#ff4fa8] text-white font-semibold py-2 rounded-lg transition-colors">Adicionar ao Carrinho</button>
      <% } %>
    </div>
  </div>
</div>
